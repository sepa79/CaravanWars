{
  "name": "caravan-wars-reboot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "npm run typecheck && npm test",
    "dev:truth-map": "tsx apps/truth-map/src/server.ts",
    "sim:regional": "tsx packages/world-sim/src/regional-economy-cli.ts",
    "sim:seasonal": "tsx packages/world-sim/src/seasonal-economy-cli.ts",
    "sim:expedition": "tsx packages/world-sim/src/expedition-cli.ts",
    "test:browser": "playwright test",
    "test": "tsx --test packages/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
